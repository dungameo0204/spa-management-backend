    "db:migrate:rosa": "node scripts/apply-rosa-schema.js",
    "test:rosa:mysql": "node --require dotenv/config scratch/test_rosa_schema_mysql.js",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate:commission": "node scripts/apply-commission-migration.js",
