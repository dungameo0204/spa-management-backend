    "test:customer-bookings": "node scratch/test_customer_bookings.js",
    "test:customer-bookings:mysql": "node --require dotenv/config scratch/test_customer_bookings_mysql.js",
    "test:treatment-groups": "node scratch/test_treatment_groups.js && node scratch/test_treatment_history_metadata.js",
    "test:treatment-groups:mysql": "node --require dotenv/config scratch/test_treatment_groups_mysql.js",
    "test:product-components": "node scratch/test_product_components.js",
