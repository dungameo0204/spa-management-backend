    "test:skin-images": "node scratch/test_skin_image_storage.js",
    "test:skin-images:mysql": "node --require dotenv/config scratch/test_skin_images_mysql.js",
    "db:migrate:rosa-image-sessions": "node scripts/apply-rosa-image-sessions.js",
