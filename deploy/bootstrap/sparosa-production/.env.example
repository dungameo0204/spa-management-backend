# Rosa production backend. Copy to C:\SpaBackend\config\.env and replace secrets only on the server.
NODE_ENV=production
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rosa
DB_PASSWORD=replace-with-a-long-random-local-password
DB_SYSTEM_NAME=db_system_master
JWT_SECRET=replace-with-a-long-random-jwt-secret
CORS_ORIGINS=https://app-spa-rosa.infinityhavocx.men
SKIN_IMAGES_ENABLED=true
UPLOAD_ROOT=C:/SpaBackend/uploads