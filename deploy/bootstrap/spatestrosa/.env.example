# Spa Test Rosa backend. Copy to C:\SpaBackend\config\.env and replace secret values locally.
NODE_ENV=production
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=spa_backend
DB_PASSWORD=replace-with-a-strong-test-password
DB_SYSTEM_NAME=db_system_master
JWT_SECRET=replace-with-a-long-random-test-secret
CORS_ORIGINS=https://app-spa-testrosa.infinityhavocx.men
# Skin-image upload is enabled for every valid tenant provisioned from db_spa_template. Keep DB_PORT=3306.
SKIN_IMAGES_ENABLED=true
UPLOAD_ROOT=C:/SpaBackend/uploads